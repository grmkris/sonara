{
  "name": "server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "src/server.ts",
  "exports": {
    ".": "./src/server.ts",
    "./rpc": "./src/rpc/app.router.ts"
  },
  "scripts": {
    "dev": "bun run --hot src/server.ts",
    "start": "bun run src/server.ts",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint",
    "fix": "oxlint --fix",
    "test": "bun test || echo 'no tests yet'",
    "ingest-demo": "bun run src/scripts/ingest-demo.ts",
    "seed:library": "bun run scripts/seed-library.ts",
    "gen:deck": "bun run scripts/gen-deck-offline.ts",
    "export:library": "bun run scripts/export-library.ts",
    "build:manifests": "bun run scripts/build-library-manifests.ts",
    "seed-credits": "bun run scripts/seed-credits.ts",
    "purge-wallet-users": "bun run scripts/purge-wallet-users.ts"
  },
  "dependencies": {
    "@dodopayments/better-auth": "^1.6.3",
    "@fal-ai/client": "^1.10.1",
    "@sonara/api": "workspace:*",
    "@sonara/db": "workspace:*",
    "@sonara/logger": "workspace:*",
    "@sonara/shared": "workspace:*",
    "@orpc/server": "^1.14.4",
    "better-auth": "^1.6.14",
    "dodopayments": "^2.35.0",
    "drizzle-orm": "^0.45.2",
    "hono": "^4.12.23",
    "pg": "^8.21.0",
    "sharp": "^0.34.2",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@sonara/test-utils": "workspace:*",
    "@types/bun": "^1.3.14",
    "@types/pg": "^8.20.0",
    "typescript": "^6.0.3"
  }
}
