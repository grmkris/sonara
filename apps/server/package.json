{
  "name": "server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "src/server.ts",
  "scripts": {
    "dev": "bun run --hot src/server.ts",
    "start": "bun run src/server.ts",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint",
    "fix": "oxlint --fix",
    "test": "bun test || echo 'no tests yet'",
    "ingest-demo": "bun run src/scripts/ingest-demo.ts",
    "seed:library": "bun run scripts/seed-library.ts",
    "export:library": "bun run scripts/export-library.ts"
  },
  "dependencies": {
    "@fal-ai/client": "^1.9.5",
    "@sonara/api": "workspace:*",
    "@sonara/db": "workspace:*",
    "@sonara/shared": "workspace:*",
    "@orpc/server": "^1.14.0",
    "drizzle-orm": "^0.45.2",
    "hono": "^4.12.12",
    "pg": "^8.20.0",
    "pino": "^10.3.1",
    "pino-pretty": "^13.0.0",
    "sharp": "^0.34.2",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@sonara/test-utils": "workspace:*",
    "@types/bun": "^1.3.12",
    "@types/pg": "^8.20.0",
    "typescript": "^6.0.3"
  }
}
