{
	admin off
	auto_https off
}

# Single public entry. Path-routes the backend surface to the server and
# everything else to the Next.js web app, all over Railway's internal network.
# Hosts default to *.railway.internal; override SERVER_URL / WEB_URL per env.
:{$PORT} {
	@server path /api/auth/* /rpc/* /api/upload/* /ws /ws/stage

	handle @server {
		reverse_proxy {$SERVER_URL:http://server.railway.internal:4471} {
			# Disable response buffering: required for the /ws WebSocket
			# upgrade and any streamed (SSE-style) responses.
			flush_interval -1
		}
	}

	handle {
		# Immutable content-addressed library frames (img_<typeid>.webp) — a
		# far-future cache so the first visit + offline prefetch also stick in
		# the browser's HTTP cache, not just the service worker.
		@frames path *.webp
		header @frames Cache-Control "public, max-age=31536000, immutable"

		# The service worker must revalidate on every load so a new deploy's
		# sw.js is picked up promptly.
		@sw path /sw.js
		header @sw Cache-Control "no-cache"

		reverse_proxy {$WEB_URL:http://web.railway.internal:4472}
	}
}
