{
	admin off
	auto_https off
}

# Single public entry. Path-routes the backend surface to the server and
# everything else to the Next.js web app, all over Railway's internal network.
# Hosts default to *.railway.internal; override SERVER_URL / WEB_URL per env.
:{$PORT} {
	@server path /api/auth/* /rpc/* /api/upload/* /ws

	handle @server {
		reverse_proxy {$SERVER_URL:http://server.railway.internal:4471} {
			# Disable response buffering: required for the /ws WebSocket
			# upgrade and any streamed (SSE-style) responses.
			flush_interval -1
		}
	}

	handle {
		reverse_proxy {$WEB_URL:http://web.railway.internal:4472}
	}
}
