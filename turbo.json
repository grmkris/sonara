{
  "$schema": "https://turbo.build/schema.json",
  "ui": "stream",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "inputs": ["$TURBO_DEFAULT$", ".env*"],
      "outputs": ["dist/**", ".next/**", "!.next/cache/**"]
    },
    "typecheck": {
      "dependsOn": ["^typecheck"],
      "outputs": [],
      "cache": true
    },
    "lint": {
      "outputs": [],
      "cache": true
    },
    "test": {
      "outputs": [],
      "cache": false,
      "env": [
        "NODE_ENV",
        "APP_ENV",
        "DATABASE_URL",
        "BETTER_AUTH_SECRET",
        "FAL_KEY",
        "AUDD_API_KEY"
      ]
    },
    "dev": {
      "cache": false,
      "persistent": true
    }
  }
}
