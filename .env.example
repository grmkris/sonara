# apps/server

# REQUIRED — image generation (FLUX.2). The server refuses to start without
# it. BYOK on a per-session basis still overrides per-call, but the platform
# needs its own key as a default.
FAL_KEY=

# REQUIRED — song recognition via AudD (https://audd.io). The `return=
# apple_music` parameter bundles genre + album art + ISRC into the response,
# so no second API key is needed.
AUDD_API_KEY=

# REQUIRED — HMAC secret for WebSocket ticket verification. Must match
# apps/web's BETTER_AUTH_SECRET. 32+ random bytes; generate with
# `openssl rand -base64 32`.
BETTER_AUTH_SECRET=

# REQUIRED — Postgres (Neon) connection string. Credits ledger + SIWE nonces.
# Must match apps/web's DATABASE_URL.
DATABASE_URL=

# Optional — override the fal-hosted LLM used for voice intent / drift.
# Defaults to google/gemini-2.5-flash-lite. See fal.ai/models/fal-ai/any-llm.
FAL_LLM_MODEL=

# Optional — Deepgram Flux (listen v2) conversational STT. When unset, the
# client falls back to the browser-native Web Speech API. Flux ships a
# model-integrated end-of-turn detector; eot_threshold tunes how eagerly it
# commits turns (0.5 = fast, may cut hesitant; 0.85 = slow, safer).
DEEPGRAM_API_KEY=
DEEPGRAM_STT_MODEL=flux-general-en
DEEPGRAM_EOT_THRESHOLD=0.55
DEEPGRAM_EOT_TIMEOUT_MS=5000

PORT=4471
LOG_LEVEL=info

# apps/web
NEXT_PUBLIC_WS_URL=ws://localhost:4471/ws

# apps/web — auth (Phase C)
# Get a project id at https://cloud.reown.com (free).
NEXT_PUBLIC_REOWN_PROJECT_ID=
# 32+ random bytes (base64 or hex). Generate with `openssl rand -base64 32`.
BETTER_AUTH_SECRET=
# SIWE EIP-4361 domain binding. Must match the host the app is served from.
AUTH_DOMAIN=localhost:4470
APP_URL=http://localhost:4470
# Neon Postgres connection string. Create a free project at https://neon.tech
DATABASE_URL=

# apps/web — payments (Phase F)
# USDC top-ups on Base are sent to this address. Single source of truth:
# read by both the client (<TopUpButton> recipient) and /api/credits/confirm.
NEXT_PUBLIC_PAY_RECIPIENT_BASE=
