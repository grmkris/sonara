# apps/server
FAL_KEY=
# Optional — override the fal-hosted LLM used for drift synthesis.
# Defaults to google/gemini-2.5-flash-lite. See fal.ai/models/fal-ai/any-llm
# for the full list (anthropic/claude-3-5-haiku, openai/gpt-4o-mini, etc.).
FAL_LLM_MODEL=
PORT=3001
LOG_LEVEL=info

# apps/web
NEXT_PUBLIC_WS_URL=ws://localhost:3001/ws
