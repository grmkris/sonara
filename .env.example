# ─────────────────────────────────────────────────────────────────────────
# apps/server — the single backend. Owns auth, DB, payments, uploads, the
# live WebSocket session, and all secrets. Copy to apps/server/.env for local
# dev. In production these are set on the Railway `server` service.
# ─────────────────────────────────────────────────────────────────────────

# REQUIRED — image generation (FLUX.2) + image-anchor upload. The server
# refuses to start without it.
FAL_KEY=

# REQUIRED — song recognition via AudD (https://audd.io).
AUDD_API_KEY=

# REQUIRED — Better Auth secret + HMAC key for WebSocket ticket signing.
# 32+ random bytes; generate with `openssl rand -base64 32`.
BETTER_AUTH_SECRET=

# REQUIRED — Postgres connection string (auth tables + credits ledger).
# Local dev: `bun run db:start` brings up Postgres 17 on localhost:54324.
# Production: Railway injects ${{Postgres.DATABASE_URL}} automatically.
DATABASE_URL=postgresql://postgres:postgres@localhost:54324/musicviz

# REQUIRED — public origin the browser sees (the Caddy gateway). Better Auth
# uses it as baseURL + trustedOrigin; credits checkout uses it for return_url.
# Local: the gateway runs on :4470. Production: https://sonara.fm
APP_URL=http://localhost:4470

# Optional — Dodo Payments. Empty values disable checkout + the webhook; login
# still works. Required in production. The webhook is served by Better Auth at
# <APP_URL>/api/auth/dodopayments/webhook — set that as the Dodo webhook URL.
DODO_PAYMENTS_API_KEY=
DODO_PAYMENTS_WEBHOOK_SECRET=
DODO_PAYMENTS_MODE=test_mode
DODO_PRODUCT_STARTER=
DODO_PRODUCT_PRO=
DODO_PRODUCT_MAX=

# Optional — override the fal-hosted LLM used for drift / song-muse.
FAL_LLM_MODEL=

PORT=4471
LOG_LEVEL=info

# ─────────────────────────────────────────────────────────────────────────
# apps/web — thin Next.js frontend. No DB, no secrets. Copy to apps/web/.env.
# ─────────────────────────────────────────────────────────────────────────

# Public WebSocket origin. Same-origin through the gateway in dev; the public
# wss:// origin in production (e.g. wss://sonara.fm/ws).
NEXT_PUBLIC_WS_URL=ws://localhost:4470/ws

# Optional — server-internal RPC URL used only during SSR (no window to read
# the gateway origin from). Local default is the server port; in production
# set it to the internal address, e.g. http://server.railway.internal:4471
RPC_INTERNAL_URL=http://localhost:4471

# ─────────────────────────────────────────────────────────────────────────
# apps/gateway — Caddy reverse proxy (the only public service). Local dev uses
# the defaults baked into `bun --filter gateway dev`. In production set these
# on the Railway `gateway` service:
#   PORT=4470
#   SERVER_URL=http://server.railway.internal:4471
#   WEB_URL=http://web.railway.internal:4472
# ─────────────────────────────────────────────────────────────────────────
