# ─────────────────────────────────────────────────────────────────────────
# apps/server — the single backend. Owns auth, DB, payments, uploads, the
# live WebSocket session, and all secrets. Copy to apps/server/.env for local
# dev. In production these are set on the Railway `server` service.
# ─────────────────────────────────────────────────────────────────────────

# REQUIRED — which environment this is: local | dev | prod. The ONLY env var
# that changes between environments — every per-environment URL (public origin,
# WS origin, SSR-internal RPC) plus the logger mode and Dodo test/live mode are
# derived from it via SERVICE_URLS in @sonara/shared. No default: a deploy that
# forgets it fails to boot rather than silently using localhost.
APP_ENV=local

# REQUIRED — image generation (FLUX.2) + image-anchor upload. The server
# refuses to start without it.
FAL_KEY=

# REQUIRED — song recognition via AudD (https://audd.io).
AUDD_API_KEY=

# REQUIRED — Better Auth secret + HMAC key for WebSocket ticket signing.
# 32+ random bytes; generate with `openssl rand -base64 32`.
BETTER_AUTH_SECRET=

# REQUIRED — Postgres connection string (auth tables + credits ledger).
# Local dev: `bun run db:start` brings up Postgres 17 on localhost:54324.
# Production: Railway injects ${{Postgres.DATABASE_URL}} automatically.
DATABASE_URL=postgresql://postgres:postgres@localhost:54324/musicviz

# Optional — Dodo Payments. Empty values disable checkout + the webhook; login
# still works. Required in production. The webhook is served by Better Auth at
# <origin>/api/auth/dodopayments/webhook — set that as the Dodo webhook URL.
# (test_mode vs live_mode is derived from APP_ENV; no separate var.)
DODO_PAYMENTS_API_KEY=
DODO_PAYMENTS_WEBHOOK_SECRET=
DODO_PRODUCT_STARTER=
DODO_PRODUCT_PRO=
DODO_PRODUCT_MAX=

# Optional — override the fal-hosted LLM used for drift / song-muse.
FAL_LLM_MODEL=

PORT=4471
LOG_LEVEL=info

# Optional — Monad "stage" (drive the live visuals with on-chain txs). When
# SONARA_STAGE_CONTRACT is set, the server subscribes to the SonaraStage
# contract's events over MONAD_RPC_WSS and folds them into live sessions;
# empty = dormant. Knob taps are free; prompts pay the contract's USDC price
# (see docs/usdc-stage-payments.md). MCP_AGENT_KEY is the EOA the MCP agent VJs
# with — it pays its own testnet gas AND needs testnet USDC to prompt (fund at
# https://faucet.circle.com). PIMLICO_API_KEY is optional — lifts the public
# gasless bundler's rate limit before a live demo. Generate a key with
# `cast wallet new`.
MONAD_RPC_WSS=wss://testnet-rpc.monad.xyz
SONARA_STAGE_CONTRACT=
PROMPT_DWELL_MS=12000
MCP_AGENT_KEY=
PIMLICO_API_KEY=

# ─────────────────────────────────────────────────────────────────────────
# apps/web — thin Next.js frontend. No DB, no secrets. Copy to apps/web/.env.
# ─────────────────────────────────────────────────────────────────────────

# Which environment the web build targets: local | dev | prod. NEXT_PUBLIC_* is
# inlined at build time; the WS origin + SSR-internal RPC URL + devtools overlay
# are all derived from it via SERVICE_URLS. On Railway this is a web build arg.
NEXT_PUBLIC_APP_ENV=local

# Optional — SonaraStage contract address (Monad testnet) for the /stage crowd
# UI. Empty hides it. Same address as the server's SONARA_STAGE_CONTRACT.
NEXT_PUBLIC_SONARA_STAGE_CONTRACT=

# Gasless audience transactions via Pimlico (ERC-4337). BOTH are required to
# sponsor gas — Pimlico's public endpoint refuses without an API key + a gas
# sponsorship policy. Create them (free) at https://dashboard.pimlico.io for
# Monad testnet (chain 10143). If the policy restricts callable contracts, it
# must allow the stage contract AND the testnet USDC token (the first prompt
# batches a USDC approve into its sponsored UserOp). On Railway these are web
# build args.
NEXT_PUBLIC_PIMLICO_API_KEY=
NEXT_PUBLIC_PIMLICO_SPONSORSHIP_POLICY_ID=

# ─────────────────────────────────────────────────────────────────────────
# apps/gateway — Caddy reverse proxy (the only public service). Local dev uses
# the defaults baked into `bun --filter gateway dev`. In production set these
# on the Railway `gateway` service:
#   PORT=4470
#   SERVER_URL=http://server.railway.internal:4471
#   WEB_URL=http://web.railway.internal:4472
# ─────────────────────────────────────────────────────────────────────────
