# apps/server
FAL_KEY=
# Optional — override the fal-hosted LLM used for drift synthesis.
# Defaults to google/gemini-2.5-flash-lite. See fal.ai/models/fal-ai/any-llm
# for the full list (anthropic/claude-3-5-haiku, openai/gpt-4o-mini, etc.).
FAL_LLM_MODEL=
PORT=3001
LOG_LEVEL=info

# apps/web
NEXT_PUBLIC_WS_URL=ws://localhost:3001/ws

# apps/web — auth (Phase C)
# Get a project id at https://cloud.reown.com (free).
NEXT_PUBLIC_REOWN_PROJECT_ID=
# 32+ random bytes (base64 or hex). Generate with `openssl rand -base64 32`.
BETTER_AUTH_SECRET=
# SIWE EIP-4361 domain binding. Must match the host the app is served from.
AUTH_DOMAIN=localhost:3000
APP_URL=http://localhost:3000
# Neon Postgres connection string. Create a free project at https://neon.tech
DATABASE_URL=
