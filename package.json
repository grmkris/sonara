{
  "name": "music-visualizer",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "turbo run dev",
    "dev:web": "turbo run dev --filter=web",
    "dev:server": "turbo run dev --filter=server",
    "build": "turbo run build",
    "typecheck": "turbo run typecheck"
  },
  "devDependencies": {
    "@types/bun": "^1.1.14",
    "@types/node": "^25.6.0",
    "shadcn": "^4.3.0",
    "turbo": "^2.9.6",
    "typescript": "^6.0.3"
  },
  "overrides": {
    "wagmi": "3.6.1",
    "@wagmi/core": "3.4.2",
    "@wagmi/connectors": "8.0.1"
  },
  "packageManager": "bun@1.3.5"
}
