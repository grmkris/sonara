{
  "name": "sonara",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "turbo run dev",
    "dev:web": "turbo run dev --filter=web",
    "dev:server": "turbo run dev --filter=server",
    "build": "turbo run build",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "test:ci": "turbo run test --concurrency=1",
    "lint": "turbo run lint",
    "check": "ultracite check --type-aware --type-check",
    "fix": "ultracite fix --type-aware --type-check",
    "fix:unsafe": "ultracite fix --unsafe --type-aware --type-check",
    "ci:local": "turbo run lint typecheck test build --concurrency=1",
    "db:start": "bun --filter @sonara/db db:start",
    "db:stop": "bun --filter @sonara/db db:stop",
    "db:down": "bun --filter @sonara/db db:down",
    "db:watch": "bun --filter @sonara/db db:watch"
  },
  "devDependencies": {
    "@types/bun": "^1.3.14",
    "@types/node": "^25.9.1",
    "oxfmt": "^0.53.0",
    "oxlint": "1.68.0",
    "oxlint-tsgolint": "^0.23.0",
    "shadcn": "^4.10.0",
    "turbo": "^2.9.16",
    "typescript": "^6.0.3",
    "ultracite": "^7.8.1"
  },
  "packageManager": "bun@1.3.13"
}
